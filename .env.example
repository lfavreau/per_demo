# Base de datos
TURSO_DATABASE_URL="libsql://..."
TURSO_AUTH_TOKEN="..."

# SQLite local, opcional: apunta a una base desechable para pruebas automatizadas
# sin escribir sobre dev.db. Solo aplica cuando no hay Turso/D1 configurado.
LOCAL_SQLITE_URL="file:test.db"

# Sesión y acceso al modo real
AUTH_SESSION_SECRET="genera-un-secreto-aleatorio-de-32-o-mas-caracteres"
REAL_MODE_PASSWORD="define-una-clave-para-la-presentacion-real"

# Notificaciones push, opcionales
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@vinculoschiloe.cl"

# Textos obligatorios en formularios (motivos, observaciones, enlaces, descripciones).
# Apagado por defecto. "true" vuelve a exigirlos (se lee al construir; en Vercel, redeploy).
# NEXT_PUBLIC_REQUIRE_TEXT_FIELDS=true
